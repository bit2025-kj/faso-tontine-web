# Base URL of the existing FastAPI backend (already deployed on Render)
FASTAPI_BASE_URL=https://tontine-backend-qoti.onrender.com

# Passed to cookie-parser. The session cookie (ftw_sid) is NOT signed today —
# its value is an opaque random UUID whose integrity doesn't need verifying
# (see sessionCookieOptions() in auth.controller.ts). Kept for any future use
# that would actually need signing. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=changeme-generate-a-real-secret

# Port the BFF listens on
PORT=3000

# Set to "production" to enable Secure cookies (requires HTTPS)
NODE_ENV=development
